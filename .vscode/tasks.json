{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Mission Recall Editor",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "${workspaceFolder}\\BuildEditor.bat"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Run Mission Recall",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "${workspaceFolder}\\RunGame.bat"],
      "dependsOn": "Build Mission Recall Editor",
      "problemMatcher": []
    }
  ]
}
